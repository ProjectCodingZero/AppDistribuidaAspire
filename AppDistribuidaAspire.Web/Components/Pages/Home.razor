@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using AppDistribuidaAspire.Web.Models
@using AppDistribuidaAspire.Web.Components.Shared
@using AppDistribuidaAspire.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject PaymentsApiClient PaymentsApiClient
@inject CartService Cart

<PageTitle>Nexo | Encontrá lo que te hace bien</PageTitle>

<div class="storefront">
	<div class="announcement-bar">
		<span>Envío gratis desde $10.000</span>
		<span class="announcement-dot" aria-hidden="true"></span>
		<span>Hasta 6 cuotas sin interés</span>
		<span class="announcement-dot" aria-hidden="true"></span>
		<span>Compra protegida con Mercado Pago</span>
	</div>

	<header class="store-header">
		<div class="header-main">
			<Brand />

			<label class="search-box">
				<span class="visually-hidden">Buscar productos</span>
				<svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
					<path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
				<input type="search"
					   placeholder="Buscar productos, marcas y más..."
					   @bind="SearchTerm"
					   @bind:event="oninput" />
				@if (!string.IsNullOrWhiteSpace(SearchTerm))
				{
					<button class="search-clear" type="button" aria-label="Limpiar búsqueda" @onclick="() => SearchTerm = string.Empty">×</button>
				}
			</label>

			<div class="account-actions">
				<AuthorizeView>
					<Authorized Context="authState">
						<span class="account-chip" title="@authState.User.Identity?.Name">
							<span class="account-avatar" aria-hidden="true">@GetInitial(authState.User.Identity?.Name)</span>
							<span class="account-name">Hola, @authState.User.Identity?.Name</span>
						</span>
						<a class="header-link" href="/account/purchases">Mis compras</a>
						<form method="post" action="/account/logout">
							<AntiforgeryToken />
							<button class="logout-button" type="submit">Salir</button>
						</form>
					</Authorized>
					<NotAuthorized>
						<a class="header-link" href="/login">Ingresá</a>
						<a class="header-cta" href="/register">Crear cuenta</a>
					</NotAuthorized>
				</AuthorizeView>
			</div>

			<a class="cart-button" href="/cart" title="Ver carrito" aria-label="Ver carrito, @Cart.ItemCount productos">
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M4 5h2l2.2 10.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
					<circle cx="10" cy="20" r="1.4" fill="currentColor"></circle>
					<circle cx="18" cy="20" r="1.4" fill="currentColor"></circle>
				</svg>
				<span class="cart-count" aria-live="polite">@Cart.ItemCount</span>
			</a>
		</div>

		<nav class="category-nav" aria-label="Navegación principal">
			<div class="category-links">
				<button class="category-pill @(SelectedCategory is null ? "category-active" : null)" @onclick="ShowAll">
					Todo
				</button>
				@foreach (var category in Categories)
				{
					<button class="category-pill @(SelectedCategory == category ? "category-active" : null)"
							@onclick="() => SelectCategory(category)">
						@category
					</button>
				}
			</div>
			<a class="nav-highlight" href="#productos">Ver catálogo <span aria-hidden="true">→</span></a>
		</nav>
	</header>

	<section class="hero-banner" aria-label="Promoción destacada">
		<span class="hero-orb hero-orb-one" aria-hidden="true"></span>
		<span class="hero-orb hero-orb-two" aria-hidden="true"></span>

		<div class="hero-copy">
			<span class="hero-eyebrow"><span class="pulse-dot" aria-hidden="true"></span> NUEVA COLECCIÓN · 2026</span>
			<h1>Objetos que<br /><em>hacen tu día</em> más simple.</h1>
			<p>Una selección cuidada de tecnología, hogar y estilo de vida. Comprá en segundos y pagá seguro con Mercado Pago.</p>
			<div class="hero-actions">
				<a class="hero-cta" href="#productos">Explorar catálogo <span aria-hidden="true">→</span></a>
				<a class="hero-secondary" href="/account/purchases">Mis compras</a>
			</div>
			<dl class="hero-stats">
				<div><dt>+2.400</dt><dd>clientes felices</dd></div>
				<div><dt>4.9/5</dt><dd>valoración</dd></div>
				<div><dt>24 h</dt><dd>despacho express</dd></div>
			</dl>
		</div>

		<div class="hero-stage" aria-hidden="true">
			@if (HeroProducts.Count > 0)
			{
				<div class="hero-float hero-float-main">
					<img src="@HeroProducts[0].ImageUrl" alt="" loading="lazy" />
					<div class="hero-float-info">
						<span>@HeroProducts[0].Category</span>
						<strong>@HeroProducts[0].Name</strong>
						<small>$ @HeroProducts[0].Price.ToString("N0")</small>
					</div>
				</div>
			}
			@if (HeroProducts.Count > 1)
			{
				<div class="hero-float hero-float-top">
					<img src="@HeroProducts[1].ImageUrl" alt="" loading="lazy" />
					<span class="hero-float-tag">Nuevo</span>
				</div>
			}
			@if (HeroProducts.Count > 2)
			{
				<div class="hero-float hero-float-bottom">
					<img src="@HeroProducts[2].ImageUrl" alt="" loading="lazy" />
					<span class="hero-float-price">$ @HeroProducts[2].Price.ToString("N0")</span>
				</div>
			}
			@if (HeroProducts.Count == 0)
			{
				<div class="hero-placeholder">✦</div>
			}
			<span class="hero-sparkle hero-sparkle-one">✦</span>
			<span class="hero-sparkle hero-sparkle-two">✦</span>
		</div>
	</section>

	<section class="benefits-strip" aria-label="Beneficios de comprar en Nexo">
		<article class="benefit">
			<span class="benefit-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" focusable="false"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path><circle cx="7" cy="18" r="1.6" fill="currentColor"></circle><circle cx="17.5" cy="18" r="1.6" fill="currentColor"></circle></svg>
			</span>
			<div><strong>Envío gratis</strong><span>En compras desde $10.000</span></div>
		</article>
		<article class="benefit">
			<span class="benefit-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" focusable="false"><path d="M12 3 5 6v5c0 4.6 2.9 8.1 7 10 4.1-1.9 7-5.4 7-10V6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</span>
			<div><strong>Compra protegida</strong><span>Pagás con Mercado Pago</span></div>
		</article>
		<article class="benefit">
			<span class="benefit-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="6" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"></rect><path d="M3 10h18M7 15h3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
			</span>
			<div><strong>Cuotas sin interés</strong><span>Hasta 6 pagos</span></div>
		</article>
		<article class="benefit">
			<span class="benefit-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" focusable="false"><path d="M20 11a8 8 0 1 0-2.3 5.7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path><path d="M20 5v6h-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</span>
			<div><strong>Devolución simple</strong><span>30 días para cambiar</span></div>
		</article>
	</section>

	<section class="products-section" id="productos">
		<div class="section-heading">
			<div>
				<p class="section-eyebrow">CURADO PARA VOS</p>
				<h2>@(SelectedCategory ?? "Todo el catálogo")</h2>
			</div>
			<div class="section-heading-meta">
				<span class="products-count">@FilteredProducts.Count productos</span>
				@if (SelectedCategory is not null || !string.IsNullOrWhiteSpace(SearchTerm))
				{
					<button class="clear-filters" type="button" @onclick="ClearFilters">Limpiar filtros</button>
				}
			</div>
		</div>

		@if (IsLoading)
		{
			<div class="empty-state"><span class="empty-state-icon" aria-hidden="true">◌</span><p>Cargando productos...</p></div>
		}
		else if (CatalogError is not null)
		{
			<div class="empty-state" role="alert"><span class="empty-state-icon" aria-hidden="true">!</span><p>@CatalogError</p></div>
		}
		else if (FilteredProducts.Count == 0)
		{
			<div class="empty-state">
				<span class="empty-state-icon" aria-hidden="true">🔎</span>
				<h2>No encontramos productos</h2>
				<p>Probá con otra búsqueda o elegí una categoría diferente.</p>
				<button class="clear-filters" type="button" @onclick="ClearFilters">Ver todos los productos</button>
			</div>
		}
		else
		{
			<div class="product-grid">
				@foreach (var product in FilteredProducts)
				{
					<ProductCard @key="product.Id"
							 Product="product"
							 CartReady="@IsCartReady"
							 OnAddToCart="AddToCart" />
				}
			</div>
		}

		@if (!string.IsNullOrWhiteSpace(AddedProductMessage))
		{
			<div class="cart-notice" role="status">
				<span class="cart-notice-icon" aria-hidden="true">✓</span>
				<span>@AddedProductMessage</span>
				<a href="/cart">Ver carrito →</a>
			</div>
		}
	</section>

	<footer class="store-footer">
		<div class="footer-main">
			<div class="footer-brand">
				<Brand />
				<p>Una tienda de demostración con pagos de Mercado Pago en modo de prueba.</p>
			</div>
			<div class="footer-column">
				<h3>Tienda</h3>
				<a href="#productos">Catálogo</a>
				<a href="/cart">Carrito</a>
				<a href="/account/purchases">Mis compras</a>
			</div>
			<div class="footer-column">
				<h3>Cuenta</h3>
				<a href="/login">Ingresar</a>
				<a href="/register">Crear cuenta</a>
			</div>
			<div class="footer-column">
				<h3>Pagos</h3>
				<span>Mercado Pago</span>
				<span>Tarjetas</span>
				<span>Dinero en cuenta</span>
			</div>
		</div>
		<div class="footer-bottom">
			<span>© 2026 Nexo. Hecho para aprender.</span>
			<span>Pagos protegidos por Mercado Pago</span>
		</div>
	</footer>
</div>

@code {
	private string SearchTerm { get; set; } = string.Empty;
	private string? SelectedCategory { get; set; }
	private IReadOnlyList<StoreProduct> Products { get; set; } = [];
	private IReadOnlyList<string> Categories => Products.Select(product => product.Category).Distinct().Order().ToArray();
	private IReadOnlyList<StoreProduct> HeroProducts => Products.Take(3).ToArray();
	private bool IsLoading { get; set; } = true;
	private bool IsCartReady { get; set; }
	private string? CatalogError { get; set; }
	private string? AddedProductMessage { get; set; }

	private IReadOnlyList<StoreProduct> FilteredProducts => Products
		.Where(product => SelectedCategory is null || product.Category == SelectedCategory)
		.Where(product => string.IsNullOrWhiteSpace(SearchTerm) ||
						  product.Name.Contains(SearchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
						  product.Category.Contains(SearchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
						  product.Brand.Contains(SearchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
		.ToList();

	private void SelectCategory(string category) => SelectedCategory = category;

	private void ShowAll() => SelectedCategory = null;

	private void ClearFilters()
	{
		SearchTerm = string.Empty;
		SelectedCategory = null;
	}

	private static string GetInitial(string? name) =>
		string.IsNullOrWhiteSpace(name) ? "N" : char.ToUpperInvariant(name.Trim()[0]).ToString();

	protected override async Task OnInitializedAsync()
	{
		Cart.Changed += OnCartChanged;

		try
		{
			Products = await PaymentsApiClient.GetProductsAsync();
		}
		catch (HttpRequestException)
		{
			CatalogError = "No pudimos cargar los productos. Intentá recargar la página.";
		}
		finally
		{
			IsLoading = false;
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!IsCartReady && !IsLoading && CatalogError is null)
		{
			await Cart.InitializeAsync(Products);
			IsCartReady = true;
			StateHasChanged();
		}
	}

	private async Task AddToCart(StoreProduct product)
	{
		await Cart.AddAsync(product);
		AddedProductMessage = $"Agregaste {product.Name} al carrito.";
	}

	private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

	public void Dispose() => Cart.Changed -= OnCartChanged;
}
