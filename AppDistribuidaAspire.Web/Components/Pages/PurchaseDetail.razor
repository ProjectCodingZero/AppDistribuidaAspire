@page "/account/purchases/{ExternalReference}"
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using AppDistribuidaAspire.Web.Services
@using AppDistribuidaAspire.Web.Components.Shared
@inject PaymentsApiClient PaymentsApiClient
@inject NavigationManager Navigation

<PageTitle>@(Purchase is null ? "Detalle del pedido" : $"Pedido #{Purchase.Id}") | Nexo</PageTitle>

<main class="purchase-page">
	<div class="purchase-shell">
		<a class="purchase-back" href="/account/purchases">← Volver a mis compras</a>

		@if (IsLoading)
		{
			<section class="purchase-message purchase-loading" role="status">
				<span class="purchase-spinner" aria-hidden="true"></span>
				<p>Cargando el pedido...</p>
			</section>
		}
		else if (Purchase is null)
		{
			<section class="purchase-message purchase-error" role="alert">
				<span class="purchase-message-icon" aria-hidden="true">!</span>
				<div>
					<h2>No pudimos encontrar el pedido</h2>
					<p>@DetailMessage</p>
					<a class="purchase-retry" href="/account/purchases">Volver al listado</a>
				</div>
			</section>
		}
		else
		{
			<header class="purchase-header detail-hero">
				<div class="detail-hero-copy">
					<p class="purchase-eyebrow">MI CUENTA <span>/</span> MIS COMPRAS</p>
					<h1>Pedido <span class="detail-order-number">#@Purchase.Id</span></h1>
					<div class="detail-hero-meta">
						<span class="detail-hero-chip">
							<span aria-hidden="true">🗓</span>
							<time datetime="@Purchase.CreatedAtUtc.ToString("O")">@Purchase.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy '·' HH:mm")</time>
						</span>
						<span class="detail-hero-chip">
							<span aria-hidden="true">📦</span>
							@TotalUnits @(TotalUnits == 1 ? "producto" : "productos")
						</span>
						<span class="purchase-status @GetStatusClass(Purchase.Status)">
							<span class="status-dot" aria-hidden="true"></span>@GetStatusLabel(Purchase.Status)
						</span>
					</div>
				</div>
				<div class="purchase-header-icon" aria-hidden="true">🧾</div>
			</header>

			<div class="detail-grid">
				<div class="detail-main">
					<PaymentVerificationView ExternalReference="@Purchase.ExternalReference" />

					<section class="detail-card">
						<header class="detail-card-head">
							<div>
								<p class="detail-card-eyebrow">COMPRA</p>
								<h2>Productos del pedido</h2>
							</div>
							<span class="detail-count">@TotalUnits</span>
						</header>

						<ul class="detail-items">
							@foreach (var item in Purchase.Items)
							{
								<li>
									<span class="detail-item-thumb" aria-hidden="true">@ItemInitial(item.ProductName)</span>
									<div class="detail-item-info">
										<h3>@item.ProductName</h3>
										<p>@item.Quantity × @Purchase.Currency @item.UnitPrice.ToString("N2")</p>
									</div>
									<strong class="detail-item-total">@Purchase.Currency @((item.UnitPrice * item.Quantity).ToString("N2"))</strong>
								</li>
							}
						</ul>

						<footer class="detail-totals">
							<div class="detail-total-line">
								<span>Artículos (@TotalUnits)</span>
								<strong>@Purchase.Currency @ItemsSubtotal.ToString("N2")</strong>
							</div>
							<div class="detail-total-line detail-total-grand">
								<span>Total del pedido</span>
								<strong>@Purchase.Currency @Purchase.Amount.ToString("N2")</strong>
							</div>
						</footer>
					</section>

					@if (!string.IsNullOrWhiteSpace(Purchase.StatusDetail))
					{
						<p class="detail-status-detail"><span aria-hidden="true">ⓘ</span> @Purchase.StatusDetail</p>
					}
					@if (Purchase.IsDevelopmentSample)
					{
						<p class="detail-dev-note"><span aria-hidden="true">ⓘ</span> Registro de ejemplo del entorno Development</p>
					}
				</div>

				<aside class="detail-side">
					<section class="detail-card">
						<header class="detail-card-head">
							<div>
								<p class="detail-card-eyebrow">RESUMEN</p>
								<h2>Datos del pago</h2>
							</div>
						</header>

						<dl class="detail-facts">
							<div>
								<dt>Número de pedido</dt>
								<dd>#@Purchase.Id</dd>
							</div>
							<div>
								<dt>Fecha</dt>
								<dd><time datetime="@Purchase.CreatedAtUtc.ToString("O")">@Purchase.CreatedAtUtc.ToLocalTime().ToString("g")</time></dd>
							</div>
							@if (Purchase.ApprovedAtUtc is not null)
							{
								<div>
									<dt>Aprobado</dt>
									<dd><time datetime="@Purchase.ApprovedAtUtc.Value.ToString("O")">@Purchase.ApprovedAtUtc.Value.ToLocalTime().ToString("g")</time></dd>
								</div>
							}
							<div>
								<dt>Estado</dt>
								<dd>
									<span class="purchase-status @GetStatusClass(Purchase.Status)">
										<span class="status-dot" aria-hidden="true"></span>@GetStatusLabel(Purchase.Status)
									</span>
								</dd>
							</div>
							<div>
								<dt>Total</dt>
								<dd class="detail-facts-total">@Purchase.Currency @Purchase.Amount.ToString("N2")</dd>
							</div>
							<div class="detail-facts-reference">
								<dt>Referencia</dt>
								<dd><code>@Purchase.ExternalReference</code></dd>
							</div>
						</dl>
					</section>

					@if (IsPayableStatus(Purchase.Status))
					{
						<section class="detail-action-card">
							<p class="detail-action-eyebrow">PAGO PENDIENTE</p>
							<p class="detail-countdown" role="timer">
								<span aria-hidden="true">⏱</span> Tiempo restante:
								<strong>@(CountdownText ?? "—")</strong>
							</p>
							<button class="detail-primary-button" type="button"
									disabled="@IsRetryingPayment"
									@onclick="RetryPaymentAsync">
								@(IsRetryingPayment ? "Abriendo Mercado Pago..." : "Intentar pago")
								@if (!IsRetryingPayment)
								{
									<span aria-hidden="true">→</span>
								}
							</button>
							@if (PaymentError is not null)
							{
								<p class="checkout-error" role="alert">@PaymentError</p>
							}
							<p class="detail-action-hint">Te vamos a redirigir a Mercado Pago para completar el pago.</p>
						</section>
					}

					<section class="detail-help">
						<span class="detail-help-icon" aria-hidden="true">🔒</span>
						<div>
							<h3>Compra protegida</h3>
							<p>El estado del pago se confirma directamente con Mercado Pago.</p>
						</div>
					</section>

					<a class="detail-secondary-link" href="/account/purchases">← Volver a mis compras</a>
				</aside>
			</div>
		}
	</div>
</main>

@code {
	/// <summary>Must match PendingOrderExpiration.Window on the API.</summary>
	private const int PaymentWindowMinutes = 5;

	private PurchaseHistoryEntry? Purchase { get; set; }
	private bool IsLoading { get; set; } = true;
	private string? DetailMessage { get; set; }
	private bool IsRetryingPayment { get; set; }
	private string? PaymentError { get; set; }
	private string? CountdownText { get; set; }
	private System.Threading.Timer? CountdownTimer { get; set; }
	private bool ReloadRequested { get; set; }

	private int TotalUnits => Purchase?.Items.Sum(item => item.Quantity) ?? 0;
	private decimal ItemsSubtotal => Purchase?.Items.Sum(item => item.UnitPrice * item.Quantity) ?? 0m;

	[Parameter]
	public string? ExternalReference { get; set; }

	protected override async Task OnInitializedAsync()
	{
		CountdownTimer = new System.Threading.Timer(
			_ => InvokeAsync(OnCountdownTick), null, 1000, 1000);
		await LoadPurchaseAsync();
	}

	private async Task LoadPurchaseAsync()
	{
		IsLoading = true;
		DetailMessage = null;

		try
		{
			Purchase = await PaymentsApiClient.GetPurchaseAsync(ExternalReference!);
			if (Purchase is null)
			{
				DetailMessage = "El pedido no existe o pertenece a otra cuenta.";
			}
		}
		catch (HttpRequestException)
		{
			DetailMessage = "No se pudo cargar el detalle del pedido. Intentá otra vez.";
		}
		finally
		{
			IsLoading = false;
		}
	}

	private void OnCountdownTick()
	{
		UpdateCountdown();

		if (ReloadRequested)
		{
			ReloadRequested = false;
			_ = LoadPurchaseAsync();
		}

		StateHasChanged();
	}

	private void UpdateCountdown()
	{
		if (Purchase is null || !IsPayableStatus(Purchase.Status))
		{
			CountdownText = null;
			return;
		}

		var deadline = DateTime.SpecifyKind(Purchase.CreatedAtUtc, DateTimeKind.Utc)
			.AddMinutes(PaymentWindowMinutes);
		var remaining = deadline - DateTime.UtcNow;

		if (remaining <= TimeSpan.Zero)
		{
			CountdownText = null;
			if (!ReloadRequested)
			{
				// Ask the API again so it applies the 5-minute cancel rule and shows the
				// order as cancelled instead of leaving a stale pending state.
				ReloadRequested = true;
			}

			return;
		}

		CountdownText = remaining.TotalHours >= 1
			? remaining.ToString(@"h\:mm\:ss")
			: remaining.ToString(@"mm\:ss");
	}

	private async Task RetryPaymentAsync()
	{
		if (Purchase is null || IsRetryingPayment)
		{
			return;
		}

		IsRetryingPayment = true;
		PaymentError = null;

		try
		{
			var checkout = await PaymentsApiClient.RetryCheckoutAsync(Purchase.ExternalReference, Navigation.BaseUri);
			Navigation.NavigateTo(
				checkout.CheckoutUrl,
				forceLoad: checkout.CheckoutUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase));
		}
		catch (InvalidOperationException exception)
		{
			PaymentError = exception.Message;
		}
		catch (HttpRequestException)
		{
			PaymentError = "No se pudo retomar el pago. Intentá otra vez.";
		}
		finally
		{
			IsRetryingPayment = false;
			StateHasChanged();
		}
	}

	private static string ItemInitial(string productName)
	{
		var trimmed = productName?.Trim();
		return string.IsNullOrEmpty(trimmed) ? "•" : trimmed[..1].ToUpperInvariant();
	}

	private static bool IsPayableStatus(string status) =>
		status.ToLowerInvariant() is "pending" or "in_process";

	private static string GetStatusClass(string status) => status.ToLowerInvariant() switch
	{
		"approved" => "status-approved",
		"rejected" or "checkout_error" => "status-error",
		"pending" or "in_process" or "creating_preference" => "status-pending",
		"cancelled" => "status-cancelled",
		_ => "status-default"
	};

	private static string GetStatusLabel(string status) => status.ToLowerInvariant() switch
	{
		"approved" => "Aprobado",
		"rejected" => "Rechazado",
		"pending" or "in_process" => "Pendiente",
		"cancelled" => "Cancelado",
		"creating_preference" => "Iniciando checkout",
		"checkout_error" => "Error al iniciar checkout",
		_ => status
	};

	public void Dispose() => CountdownTimer?.Dispose();
}
