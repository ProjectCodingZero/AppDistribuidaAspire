@using AppDistribuidaAspire.Web.Services
@inject PaymentsApiClient PaymentsApiClient
@inject CartService Cart

<section class="payment-card @StateClass" aria-live="polite" aria-busy="@IsVerifying">
	@if (IsVerifying)
	{
		<div class="payment-state-icon" aria-hidden="true">⌛</div>
		<p class="payment-eyebrow">ESTADO DE TU COMPRA</p>
		<h1>Verificando el pago</h1>
		<p class="payment-description">Estamos confirmando el estado de tu compra.</p>
	}
	else if (Payment is null)
	{
		<div class="payment-state-icon" aria-hidden="true">!</div>
		<p class="payment-eyebrow">NO PUDIMOS ACTUALIZAR TU COMPRA</p>
		<h1>No pudimos confirmar el pago</h1>
		<p class="payment-description">@VerificationMessage</p>
		@if (CanVerify)
		{
			<button class="payment-secondary-button" type="button" @onclick="VerifyPaymentAsync">Volver a consultar</button>
		}
	}
	else
	{
		<div class="payment-state-icon" aria-hidden="true">@StatusIcon</div>
		<p class="payment-eyebrow">ESTADO ACTUAL DE TU COMPRA</p>
		<h1>@StatusTitle</h1>
		<p class="payment-description">
			@if (string.Equals(Payment.Status, "approved", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(Payment.PaymentId))
			{
				<span>Compra aprobada en modo de prueba. No se realizó ningún cobro real.</span>
			}
			else if (string.IsNullOrWhiteSpace(Payment.PaymentId))
			{
				<span>La orden está registrada y esperamos la confirmación del pago. El resultado del navegador no se toma como confirmación.</span>
			}
			else
			{
				<span>Estado obtenido por el servidor desde Mercado Pago.</span>
			}
		</p>
		<div class="payment-status-chip">@StatusTitle</div>
		<dl class="payment-details">
			@if (!string.IsNullOrWhiteSpace(Payment.PaymentId))
			{
				<dt>Pago</dt>
				<dd>@Payment.PaymentId</dd>
			}
			@if (!IsDemoCheckout)
			{
				<dt>Preferencia</dt>
				<dd>@Payment.PreferenceId</dd>
			}
			<dt>Importe</dt>
			<dd>$ @Payment.Amount.ToString("N2") @Payment.Currency</dd>
			<dt>Estado</dt>
			<dd>@Payment.Status @if (!string.IsNullOrWhiteSpace(Payment.StatusDetail)) { <span>(@Payment.StatusDetail)</span> }</dd>
			@if (!string.IsNullOrWhiteSpace(Payment.PaymentMethodId))
			{
				<dt>Medio de pago</dt>
				<dd>@Payment.PaymentMethodId</dd>
			}
			@if (Payment.ApprovedAtUtc.HasValue)
			{
				<dt>Aprobado</dt>
				<dd>@Payment.ApprovedAtUtc.Value.ToLocalTime().ToString("g")</dd>
			}
		</dl>
		@if (!string.Equals(Payment.Status, "approved", StringComparison.OrdinalIgnoreCase) && CanVerify)
		{
			<button class="payment-secondary-button" type="button" @onclick="VerifyPaymentAsync">Actualizar estado</button>
		}
	}
</section>

@code {
	private VerifiedPayment? Payment { get; set; }
	private string? VerificationMessage { get; set; }
	private bool IsVerifying { get; set; }
	private bool _cartCleared;
	private bool _pendingCartClear;
	private bool CanVerify => IsValidPaymentId(PaymentId) || !string.IsNullOrWhiteSpace(ExternalReference);
	private bool IsDemoCheckout => string.Equals(Payment?.PreferenceId, "demo", StringComparison.OrdinalIgnoreCase);
	private string StateClass => IsVerifying ? "payment-state-checking" : Payment is null ? "payment-state-error" : Payment.Status.ToLowerInvariant() switch
	{
		"approved" => "payment-state-approved",
		"pending" or "in_process" or "in_mediation" => "payment-state-pending",
		"rejected" or "cancelled" => "payment-state-rejected",
		_ => "payment-state-unknown"
	};
	private string StatusIcon => Payment?.Status.ToLowerInvariant() switch
	{
		"approved" => "✓",
		"pending" or "in_process" or "in_mediation" => "⌛",
		"rejected" or "cancelled" => "×",
		_ => "i"
	};

	[Parameter]
	public string? PaymentId { get; set; }

	[Parameter]
	public string? ExternalReference { get; set; }

	protected override Task OnParametersSetAsync() => VerifyPaymentAsync();

	// JS interop (and therefore the cart storage) is only available once the
	// component is interactive. During prerendering OnAfterRenderAsync never runs,
	// so the cart is cleared here instead of inside OnParametersSetAsync.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_pendingCartClear)
		{
			return;
		}

		_pendingCartClear = false;
		_cartCleared = true;
		await Cart.ClearAsync();
	}

	private async Task VerifyPaymentAsync()
	{
		Payment = null;
		VerificationMessage = null;

		if (!CanVerify)
		{
			VerificationMessage = "Mercado Pago no devolvió un identificador de pago ni de orden.";
			return;
		}

		IsVerifying = true;
		try
		{
			Payment = IsValidPaymentId(PaymentId)
				? await PaymentsApiClient.VerifyPaymentAsync(PaymentId!)
				: await PaymentsApiClient.GetOrderStatusAsync(ExternalReference!);
			if (Payment is null)
			{
				VerificationMessage = "El pago no coincide con una compra creada por esta tienda.";
			}
			else if (string.Equals(Payment.Status, "approved", StringComparison.OrdinalIgnoreCase) && !_cartCleared)
			{
				_pendingCartClear = true;
			}
		}
		catch (HttpRequestException)
		{
			VerificationMessage = "No pudimos consultar Mercado Pago. Verificá la conexión e intentá nuevamente.";
		}
		finally
		{
			IsVerifying = false;
		}
	}

	private static bool IsValidPaymentId(string? paymentId) =>
		long.TryParse(paymentId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var numericId)
		&& numericId > 0;

	private string StatusTitle => Payment?.Status.ToLowerInvariant() switch
	{
		"approved" => "Pago aprobado",
		"pending" or "in_process" or "in_mediation" => "Pago pendiente",
		"rejected" => "Pago rechazado",
		"cancelled" => "Pago cancelado",
		_ => "Estado del pago"
	};
}
