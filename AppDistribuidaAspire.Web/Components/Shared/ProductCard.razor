@using AppDistribuidaAspire.Web.Models

<article class="product-card">
	<div class="product-image-wrap">
		<img class="product-image"
			 src="@Product.ImageUrl"
			 alt="@Product.Name"
			 loading="lazy" />
	</div>

	<div class="product-info">
		<p class="product-name">@Product.Name</p>
		<p class="product-category">@Product.Category · @Product.Brand</p>
		<p class="product-description">@Product.Description</p>
		<p class="product-price">$ @Product.Price.ToString("N0")</p>
		<p class="product-stock">@(Product.Stock > 0 ? $"Stock: {Product.Stock}" : "Sin stock")</p>

		<button class="add-to-cart-button"
				type="button"
				disabled="@(Product.Stock == 0 || !CartReady)"
				@onclick="() => OnAddToCart.InvokeAsync(Product)">
			@(CartReady ? "Agregar al carrito" : "Cargando carrito...")
		</button>
	</div>
</article>

@code {
	[Parameter, EditorRequired]
	public StoreProduct Product { get; set; } = default!;

	[Parameter]
	public EventCallback<StoreProduct> OnAddToCart { get; set; }

	[Parameter]
	public bool CartReady { get; set; }
}
